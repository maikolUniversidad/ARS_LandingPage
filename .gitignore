# Dependencies
node_modules/
.pnp
.pnp.js

# Build
.next/
out/
build/
dist/

# Environment — NINGÚN .env* se sube, salvo la plantilla .env.example
# (guía: docs/CONFIGURACION.md)
.env
.env.*
!.env.example
*.env
*.env.local

# Claves, certificados y credenciales (nunca al repo)
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
*-service-account.json
secrets/
.secrets/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel (vínculo local del proyecto; `vercel env pull` escribe .env.local)
.vercel/
.vercel

# Local settings (not project config)
.claude/settings.local.json

# User-specific skills (not part of the template)
.claude/skills/customize/
.claude/skills/release/

# Local temp files
temp/

# ARS — local research notes (extracted from brand PDFs)
docs/research/*.txt

# Claude Code internal worktrees
.claude/worktrees/
.claude/scheduled_tasks.lock

# Carpeta de staging de modelos entrenados (no va al deploy; pesados).
# Los modelos en uso se copian a /public/models/<demo>/.
/Export/

# Modelos de IA auto-hospedados (se bajan en postinstall: scripts/fetch-models.mjs)
/public/mediapipe/
/public/tesseract/
/public/ort/
/public/models/plate/
/public/models/vigias/*
!/public/models/vigias/README.txt

# Material de trabajo local de las demos de visión: videos, salidas y un
# perfil de Chrome (cookies/sesiones). ~1,4 GB — NUNCA se sube.
/vision-trabajo/

# Salidas locales de pruebas de audio/imagen/video (TTS, STT, capturas)
*.local.mp3
*.local.wav
*.local.webm
/tmp-audio/
/tmp-imagenes/
/salidas/
