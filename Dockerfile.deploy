# Imagen de producción a partir de un build YA HECHO en el host
# (npm ci --ignore-scripts --force && node scripts/fetch-models.mjs && npm run build),
# para no compilar dentro de docker build. Mismo runtime que el Dockerfile original.
#
#   docker build --provenance=false --sbom=false -f Dockerfile.deploy -t <img>:<tag> .
ARG NODE_VERSION=24.14.1-slim
FROM node:${NODE_VERSION} AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1
COPY --chown=node:node .next/standalone ./
COPY --chown=node:node .next/static ./.next/static
COPY --chown=node:node public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
