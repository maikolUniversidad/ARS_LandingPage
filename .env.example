# ═════════════════════════════════════════════════════════════════════
# ARS Intelligence · Landing — Variables de entorno
# ═════════════════════════════════════════════════════════════════════
# Uso:   cp .env.example .env.local   (y completa solo lo que necesites)
# Guía:  docs/CONFIGURACION.md
#
# • .env.local NUNCA se sube a git (.gitignore ignora todo .env* salvo este).
# • Este archivo es una PLANTILLA: no pongas aquí claves reales.
# • Todas las claves son SOLO de servidor. Nunca les pongas el prefijo
#   NEXT_PUBLIC_ (eso las incrusta en el JavaScript que baja el navegador).
# • Ninguna variable es obligatoria para que el sitio arranque: si falta una,
#   la función asociada se degrada (ver cada sección).
# • Una línea vacía (VAR=) equivale a "no definida" y usa el valor por defecto.


# ─────────────────────────────────────────────────────────────────────
# 1. Anthropic (Claude) — proveedor principal de IA
# ─────────────────────────────────────────────────────────────────────
# Lo usan: chat del asistente «Ars» (/api/asistente/chat), diagnóstico
# (/api/diagnostico, /api/diagnostico/entrevista), Propuesta ARS
# (/api/propuesta, /api/propuesta/preguntas), arquitecto de /plataforma
# y el planificador de visión (/api/vision/plan).
# Sin ella: diagnóstico y propuesta responden 503 en producción (en
# desarrollo usan respuestas simuladas); /plataforma y /api/vision/plan
# caen al motor de reglas; el chat usa OpenAI/DeepSeek si hay.
# Obtener: https://platform.claude.com → Settings → API keys
ANTHROPIC_API_KEY=

# Opcional. Modelo del chat/diagnóstico.  Por defecto: claude-sonnet-5-5
ASISTENTE_MODELO=
# Opcional. Modelo rápido de la Propuesta.  Por defecto: claude-haiku-5-5
ASISTENTE_MODELO_RAPIDO=


# ─────────────────────────────────────────────────────────────────────
# 2. OpenAI — proveedor alterno + búsqueda semántica
# ─────────────────────────────────────────────────────────────────────
# Lo usan: chat del asistente (respaldo; lee PDF, imágenes y fotogramas),
# arquitecto de /plataforma, y los embeddings de la búsqueda del asistente
# (src/lib/asistente/busqueda.ts + src/data/asistente/generar.mjs).
# Sin ella: el chat no tiene respaldo OpenAI y la búsqueda es solo por
# palabras clave (sigue funcionando).
# Obtener: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opcional. Modelo de OpenAI.  Por defecto: gpt-5.5
ASISTENTE_MODELO_OPENAI=


# ─────────────────────────────────────────────────────────────────────
# 3. DeepSeek — proveedor alterno económico (solo chat)
# ─────────────────────────────────────────────────────────────────────
# Endpoint compatible con Anthropic. Acepta imágenes, NO PDF: con un PDF
# adjunto el chat salta a Claude u OpenAI.
# Obtener: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Opcional. Modelo de DeepSeek.  Por defecto: deepseek-flash
ASISTENTE_MODELO_DEEPSEEK=


# ─────────────────────────────────────────────────────────────────────
# 4. Orden de proveedores del chat y modo demo
# ─────────────────────────────────────────────────────────────────────
# Opcional. Orden de preferencia; solo se usan los que tienen clave. Si uno
# falla antes de responder, pasa al siguiente.
# Por defecto: anthropic,openai,deepseek
ASISTENTE_PROVEEDORES=

# Opcional. "1" = respuestas simuladas para probar la UI sin claves.
# • Chat del asistente: solo fuera de producción.
# • Diagnóstico y Propuesta: ya simulan solos en `npm run dev`; con
#   ASISTENTE_DEMO=1 simulan también en producción si falta ANTHROPIC_API_KEY.
#   No lo actives en Vercel salvo para una demo controlada.
# ASISTENTE_DEMO=1


# ─────────────────────────────────────────────────────────────────────
# 5. ElevenLabs — voz de «Ars» (TTS, STT y agente en tiempo real)
# ─────────────────────────────────────────────────────────────────────
# Rutas: /api/asistente/tts, /stt, /stt-token, /voz-sesion.
# Sin ELEVENLABS_API_KEY: el sitio usa la voz y el reconocimiento de voz
# del navegador (Web Speech API); el agente en vivo no se ofrece.
# La clave debe ser del MISMO workspace donde está el agente.
# Permisos: Text to Speech, Speech to Text y Conversational AI / Agents.
# Obtener: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ID de la voz para leer respuestas (TTS). Sin él no hay TTS de ElevenLabs.
# No es secreto. Voz elegida: «Sofía – Confianza & Calidez» (español latino).
ELEVENLABS_VOICE_ID=b2htR0pMe28pYwCY9gnP
# ID del agente conversacional «Ars · Guía de voz ARS Intelligence».
# No es secreto. Sin él no hay conversación de voz en tiempo real.
ELEVENLABS_AGENT_ID=agent_5101m6khr039ezdvqfderetj65p6

# Opcional. Por defecto: eleven_flash_v2_5
ELEVENLABS_TTS_MODEL=
# Opcional. Por defecto: scribe_v1
ELEVENLABS_STT_MODEL=


# ─────────────────────────────────────────────────────────────────────
# 6. Resend — correos del formulario de contacto y de la Propuesta
# ─────────────────────────────────────────────────────────────────────
# Rutas: /api/contact, /api/diagnostico (resumen al equipo) y
# /api/propuesta/enviar (adjunta el PDF).
# Sin RESEND_API_KEY: el lead NO se envía por correo; queda en el registro
# (sección 7) y en el log del servidor (la UI responde OK igual).
# En producción, configúrala.
# Obtener: https://resend.com/api-keys  (y verifica tu dominio en
# https://resend.com/domains para poder usarlo en RESEND_FROM)
RESEND_API_KEY=

# Opcional. Remitente; debe ser de un dominio verificado en Resend.
# Por defecto: ARS Intelligence <onboarding@resend.dev>
RESEND_FROM=
# Opcional. Destino de los leads.  Por defecto: CONTACT_EMAIL de src/lib/contact.ts
CONTACT_TO=


# ─────────────────────────────────────────────────────────────────────
# 7. Registros de leads → módulo de ARS (ERP)
# ─────────────────────────────────────────────────────────────────────
# Cada contacto (/api/contact) y cada diagnóstico (/api/diagnostico) se
# guarda como registro (CONT-2026-XXXXXX / DIAG-2026-XXXXXX) y se envía por
# POST firmado (HMAC-SHA256) al servidor de ARS.
# Contrato completo: docs/BACKEND-REGISTROS.md
# Las TRES deben ir juntas; si falta una, el push queda desactivado y los
# registros solo se guardan en la copia local (que en Vercel NO persiste).
# Los entrega el equipo del servidor de ARS (generar: openssl rand -hex 32).
ARS_REGISTROS_URL=
ARS_REGISTROS_TOKEN=
ARS_REGISTROS_SECRET=
# Opcional. Timeout por intento (ms).  Por defecto: 8000
ARS_REGISTROS_TIMEOUT_MS=

# Opcional. Carpeta de la copia local.  Por defecto: .data/registros
REGISTROS_DIR=
# Opcional. "siempre" (por defecto) o "respaldo" (solo si el push falla).
REGISTROS_COPIA_LOCAL=
# Opcional. Cuánto espera la respuesta al usuario a que se confirme el
# guardado (ms).  Por defecto: 2500
REGISTROS_ESPERA_MS=
# Opcional. Bearer de la API pull /api/registros (GET/PATCH para el ERP).
# Vacío = API deshabilitada (503). Debe ser distinto de ARS_REGISTROS_TOKEN.
REGISTROS_API_TOKEN=
# Opcional. Sal del hash de la IP.  Por defecto: ARS_REGISTROS_SECRET
REGISTROS_SAL_IP=


# ─────────────────────────────────────────────────────────────────────
# 8. Roboflow (navegador) — detector de chalecos/EPP en las demos de visión
# ─────────────────────────────────────────────────────────────────────
# Es una "publishable key": PÚBLICA por diseño (va al navegador), por eso
# sí lleva NEXT_PUBLIC_. Opcional: el código trae una por defecto.
# Obtener: https://app.roboflow.com → Settings → API Keys → Publishable
NEXT_PUBLIC_ROBOFLOW_PUBLISHABLE_KEY=


# ─────────────────────────────────────────────────────────────────────
# 9. Scripts de desarrollo
# ─────────────────────────────────────────────────────────────────────
# Opcional. FORCE=1 hace que scripts/fetch-models.mjs (postinstall) vuelva a
# copiar/descargar los modelos de IA aunque ya existan. Úsalo en la línea de
# comandos:  FORCE=1 node scripts/fetch-models.mjs
# FORCE=1


# ─────────────────────────────────────────────────────────────────────
# 10. Reservadas — backend de visión futuro (HOY EL CÓDIGO NO LAS LEE)
# ─────────────────────────────────────────────────────────────────────
# /vision-lab solo muestra estos nombres como "proveedor no configurado".
# Se documentan para cuando exista el backend de visión (docs/vision-demo-api.md).
# Déjalas vacías.
# ROBOFLOW_API_KEY=            # https://app.roboflow.com → Settings → API Keys (privada)
# ROBOFLOW_API_URL=https://detect.roboflow.com
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=   # ruta a un JSON de service account (fuera del repo)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AZURE_VISION_ENDPOINT=
# AZURE_VISION_KEY=
# HF_TOKEN=                    # https://huggingface.co/settings/tokens (rol "read")
# USE_LOCAL_MODELS=true
# VISION_API_URL=
