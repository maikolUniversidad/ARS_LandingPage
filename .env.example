# ─────────────────────────────────────────────────────────────────────
# Vision Demo · Variables de entorno
# ─────────────────────────────────────────────────────────────────────
# Copiar este archivo a `.env` (que NUNCA se commitea) y completar las
# keys que necesites. Si una key falta, el modelo asociado aparece como
# "no configurado" en /vision-lab y no rompe la UI.
#
# Documentación completa de cada provider en `docs/vision-demo-api.md`.

# ─────────── Formulario de contacto (src/app/api/contact) ───────────
# Sin RESEND_API_KEY el lead solo queda en el log del servidor.
# https://resend.com → API Keys. RESEND_FROM debe ser un dominio verificado.
RESEND_API_KEY=
RESEND_FROM=ARS Intelligence <onboarding@resend.dev>
# Destino de los leads (por defecto CONTACT_EMAIL de src/lib/contact.ts)
CONTACT_TO=

# ─────────── Roboflow Universe ───────────
# Free tier: 1,000 inferencias/mes
# https://universe.roboflow.com → Settings → API
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://detect.roboflow.com

# ─────────── Google Cloud Vision + Video Intelligence ───────────
# Free tier: 1,000 unidades/mes
# Crear service account JSON y apuntar GOOGLE_APPLICATION_CREDENTIALS al path
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# ─────────── AWS Rekognition ───────────
# Free tier: 5,000 imágenes/mes (primeros 12 meses)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─────────── Azure AI Vision / Face API ───────────
# Free tier: 5,000 transacciones/mes
# ATENCIÓN: Face API tiene restricciones legales — solo aprobado para uso comercial limitado
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# ─────────── Hugging Face Inference (VLMs experimentales) ───────────
# https://huggingface.co/settings/tokens (rol "read")
HF_TOKEN=

# ─────────── Modo de operación del backend ───────────
# Si "true" intenta correr modelos locales (YOLO, MediaPipe, EasyOCR, InsightFace)
# Si "false" prioriza APIs externas (cuando estén configuradas)
USE_LOCAL_MODELS=true

# ─────────── URL del backend de visión (Fase 2+) ───────────
# Si no está, /vision-lab corre con mock predictions (Fase 1)
VISION_API_URL=

# ─────────────────────────────────────────────────────────────────────
# REGLAS DE SEGURIDAD
# ─────────────────────────────────────────────────────────────────────
# 1. Nunca commits `.env` real al repo (ya está en .gitignore)
# 2. Nunca uses `NEXT_PUBLIC_*` para estas keys — quedan expuestas al navegador
# 3. Todas las llamadas a APIs externas se hacen desde el backend Python,
#    nunca desde el cliente
# 4. Rotar keys periódicamente
# 5. En staging/dev usar keys de cuenta separada de producción

# ─────────────────────────────────────────────────────────────────────
# Asistente IA «Ars» (chat + voz) · src/app/api/asistente/*
# ─────────────────────────────────────────────────────────────────────
# Todas son SOLO de servidor (nunca NEXT_PUBLIC_*). Si falta alguna, el
# asistente degrada: sin ninguna clave de LLM muestra un aviso y el formulario
# de contacto; sin ElevenLabs usa la voz y el reconocimiento del navegador.

# LLM del chat. Basta con UNA de las tres; con varias, se usan en el orden de
# ASISTENTE_PROVEEDORES y, si una falla antes de responder, pasa a la siguiente.
# DeepSeek no lee PDF: con un PDF adjunto se salta a Claude o GPT.
# Opcional. Por defecto: anthropic,openai,deepseek
ASISTENTE_PROVEEDORES=

# Claude (streaming, herramientas, caché de prompt, citas en documentos)
# https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
# Opcional. Por defecto: claude-sonnet-5-5
ASISTENTE_MODELO=

# OpenAI GPT (API de Responses; lee PDF, imágenes y fotogramas de video)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Opcional. Por defecto: gpt-5.5
ASISTENTE_MODELO_OPENAI=

# DeepSeek (endpoint compatible con Anthropic; rápido y económico; imágenes sí, PDF no)
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Opcional. Por defecto: deepseek-flash
ASISTENTE_MODELO_DEEPSEEK=

# ElevenLabs (voz). La clave debe ser del mismo workspace donde está el agente.
# https://elevenlabs.io/app/settings/api-keys  (permisos: Text to Speech,
# Speech to Text y Conversational AI / Agents)
ELEVENLABS_API_KEY=
# Voz para leer respuestas (TTS). Elegida: «Sofía – Confianza & Calidez»
# (español latino, acento colombiano cálido).
ELEVENLABS_VOICE_ID=b2htR0pMe28pYwCY9gnP
# Agente conversacional en tiempo real «Ars · Guía de voz ARS Intelligence»
# (misma base de conocimiento, enviada por el servidor en cada sesión).
ELEVENLABS_AGENT_ID=agent_5101m6khr039ezdvqfderetj65p6
# Opcionales: modelos de TTS y STT
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# Solo desarrollo: respuestas simuladas para probar la UI sin claves.
# Se ignora en producción.
# ASISTENTE_DEMO=1
